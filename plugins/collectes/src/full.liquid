<style>
  /* Collectes on the 1040x780 TRMNL X: the bin and one order, nothing else. */
  .col-page { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #000; background: #fff; }
  .col-bins { display: flex; gap: 24px; }
  .col-bin { display: block; overflow: visible; }
  .col-bin path, .col-bin rect, .col-bin circle, .col-bin ellipse, .col-bin polygon { stroke: #000; stroke-width: 5; stroke-linejoin: round; stroke-linecap: round; }
  .col-big .col-bin { width: 560px; height: 560px; }
  .col-two .col-bin { width: 400px; height: 400px; }
  .col-later .col-bin { width: 260px; height: 260px; }
  .col-later .col-bin path, .col-later .col-bin rect, .col-later .col-bin circle, .col-later .col-bin ellipse, .col-later .col-bin polygon { stroke: #b8b8b8; }
  .col-sors { letter-spacing: -2px; margin-top: -10px; white-space: nowrap; }
</style>

<div class="col-page">
  {% if sortir %}
    <div class="col-bins {% if matieres.size > 1 %}col-two{% else %}col-big{% endif %}">
      {% for matiere in matieres %}{{ matiere.svg }}{% endfor %}
    </div>
    <div class="col-sors value value--xxlarge text--bold">{{ texte }}</div>
  {% elsif matieres.size > 0 %}
    <div class="col-bins col-later">
      {% for matiere in matieres %}{{ matiere.svg }}{% endfor %}
    </div>
  {% else %}
    <span class="title">Horaire à régler dans les paramètres du Plugin</span>
  {% endif %}
</div>
