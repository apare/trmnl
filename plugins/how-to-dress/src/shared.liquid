{% comment %}body: the bare mannequin, in the 200 × 414 drawing the transform's boxes use.{% endcomment %}
{% template body %}<g fill="#d4d4d4" stroke="#000" stroke-width="3">
  <rect x="62" y="205" width="34" height="145" rx="12"/><rect x="104" y="205" width="34" height="145" rx="12"/>
  <rect x="28" y="96" width="22" height="118" rx="11"/><rect x="150" y="96" width="22" height="118" rx="11"/>
  <rect x="55" y="88" width="90" height="125" rx="20"/><rect x="90" y="70" width="20" height="22"/>
  <circle cx="100" cy="45" r="32" fill="#fff"/></g>
<g fill="#000"><circle cx="89" cy="44" r="4"/><circle cx="111" cy="44" r="4"/></g>
<path d="M88 58 Q100 68 112 58" fill="none" stroke="#000" stroke-width="3" stroke-linecap="round"/>{% endtemplate %}

{% comment %}mannequin: the body wearing a list of pieces from the transform.{% endcomment %}
{% template mannequin %}<svg class="htd-mannequin {{ size }}" viewBox="0 -14 200 414">{% render 'body' %}{% for p in pieces %}
<svg x="{{ p.x }}" y="{{ p.y }}" width="{{ p.w }}" height="{{ p.h }}" viewBox="-6 -6 112 112" preserveAspectRatio="none" class="ico">{% if p.mirrored %}<g transform="translate(100 0) scale(-1 1)">{% endif %}{% render 'icon', key: p.key %}{% if p.mirrored %}</g>{% endif %}</svg>{% endfor %}</svg>{% endtemplate %}
