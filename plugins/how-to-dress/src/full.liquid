<style>
  /* Approved D geometry for the full Layout on the 1040x780 TRMNL X. */
  .htd-dashboard { --htd-scale: 1; position: absolute; inset: 0; width: 1040px; height: 780px; color: #000; font-family: Inter, "Helvetica Neue", sans-serif; line-height: normal; }
  .htd-dashboard svg { display: block; overflow: visible; }
  .htd-dashboard svg text { font-family: inherit; }
  .htd-dashboard .halo { paint-order: stroke; stroke: #fff; stroke-width: 5px; stroke-linejoin: round; }

  .htd-dashboard .main { height: 522px; margin-top: 16px; flex: none; display: flex; gap: 14px; padding: 0 16px; }
  .htd-dashboard .scene { position: relative; width: 622px; flex: none; box-sizing: border-box; border: 2px solid #000; border-radius: 14px; overflow: hidden; }
  .htd-dashboard .scene > .layers { position: absolute; inset: 0; }
  .htd-dashboard .kids, .htd-dashboard .kids > svg { position: absolute; inset: 0; }
  .htd-dashboard .mq { position: absolute; }
  .htd-dashboard .mq > img, .htd-dashboard .layers > img { position: absolute; }
  .htd-dashboard .bottom { flex: 1; padding: 2px 20px 0; }
  .htd-dashboard .cards { width: 372px; flex: none; display: flex; flex-direction: column; gap: 10px; }
  .htd-dashboard .line { display: flex; gap: 10px; align-items: center; }
  .htd-dashboard .card { border: 2px solid #000; border-radius: 12px; padding: 6px 10px; display: flex; flex-direction: column; flex: 1; justify-content: center; }
  .htd-dashboard .card h3 { margin: 0; font-size: calc(15px * var(--htd-scale)); text-transform: uppercase; letter-spacing: 1px; }
  .htd-dashboard .two { display: flex; gap: 8px; }
  .htd-dashboard .two > div { flex: 1; display: flex; align-items: center; gap: 6px; }
  .htd-dashboard .big { font-size: calc(40px * var(--htd-scale)); font-weight: 800; line-height: 1; }
  .htd-dashboard .small { font-size: calc(14px * var(--htd-scale)); font-weight: 600; }
  .htd-dashboard .two .small { white-space: nowrap; }
  .htd-dashboard .two .wrap { white-space: normal; }
  .htd-dashboard .two.tops > div { align-items: flex-start; }
  .htd-dashboard .mid { font-size: calc(20px * var(--htd-scale)); font-weight: 800; }
  .htd-dashboard .storm { margin-top: 4px; }
  .htd-dashboard .page { position: absolute; inset: 0; display: flex; flex-direction: column; }
</style>

{% if error %}
<div class="layout"><span class="title title--large">{{ error }}</span></div>
<div class="title_bar"><span class="title">Comment s'habiller</span></div>
{% else %}
<div class="htd-dashboard">
  <div class="page">
    <div class="main">
      <div class="scene">{{ dashboard.scene }}{{ dashboard.kids }}</div>
      <div class="cards">{{ dashboard.cards }}</div>
    </div>
    <div class="bottom">{{ dashboard.chart }}</div>
  </div>
</div>
{% endif %}
